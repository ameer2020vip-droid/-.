rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRootAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'ameer2020vip@gmail.com' ||
        request.auth.token.email == 'Ameer2020vip@gmail.com'
      );
    }

    function isUserActive() {
      return isSignedIn() && (
        isRootAdminEmail() ||
        !hasUserDoc() ||
        getUserData().active != false
      );
    }

    function getUserRole() {
      return hasUserDoc() ? getUserData().role : 'counselor';
    }

    function getUserSchoolId() {
      return (hasUserDoc() && getUserData().schoolId != null) ? getUserData().schoolId : '7001';
    }

    function isSystemOwner() {
      return isSignedIn() && (
        isRootAdminEmail() ||
        (hasUserDoc() && getUserData().active != false && (
          getUserRole() == 'system_owner' ||
          getUserRole() == 'systemAdmin' ||
          getUserRole() == 'admin'
        ))
      );
    }

    function isSystemAdmin() {
      return isSystemOwner();
    }

    function isKnownSchool(schoolId) {
      return schoolId == '7001' || schoolId == 'alkhalil-school' || schoolId == 'school-main' || schoolId == 'default-school' || schoolId == 'fujairah-academy' || schoolId == 'fujairah-islamic';
    }

    function isSchoolMember(schoolId) {
      return !hasUserDoc() || getUserSchoolId() == schoolId || (isKnownSchool(getUserSchoolId()) && isKnownSchool(schoolId));
    }

    function isSchoolAdmin(schoolId) {
      return isUserActive() && (
        isSystemOwner() ||
        ((getUserRole() == 'school_admin' || getUserRole() == 'schoolAdmin') && isSchoolMember(schoolId))
      );
    }

    function isCounselor(schoolId) {
      return isUserActive() && getUserRole() != 'viewer' && (
        isSchoolAdmin(schoolId) ||
        isSchoolMember(schoolId)
      );
    }

    function isAuthorizedCommunicator(schoolId) {
      return isUserActive() && getUserRole() != 'viewer' && (
        isSystemOwner() ||
        isSchoolAdmin(schoolId) ||
        isSchoolMember(schoolId)
      );
    }

    function canReadSchool(schoolId) {
      return isUserActive() && (
        isSystemOwner() ||
        isSchoolMember(schoolId) ||
        isKnownSchool(schoolId)
      );
    }

    // --------------------------------------------------------------------------
    // Connection test document (used by SDK initialization check)
    // --------------------------------------------------------------------------
    match /test/{docId} {
      allow read: if true;
    }

    // --------------------------------------------------------------------------
    // Users collection rules
    // --------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        isRootAdminEmail() ||
        isSystemOwner() ||
        (isUserActive() && (getUserRole() == 'school_admin' || getUserRole() == 'schoolAdmin'))
      );

      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        isRootAdminEmail() ||
        isSystemOwner() ||
        (isUserActive() && (getUserRole() == 'school_admin' || getUserRole() == 'schoolAdmin'))
      );

      allow delete: if isSystemOwner();
    }

    // --------------------------------------------------------------------------
    // Schools top-level and subcollections
    // --------------------------------------------------------------------------
    match /schools/{schoolId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        isSystemOwner() ||
        isKnownSchool(schoolId) ||
        request.resource.data.status == 'pending' ||
        request.resource.data.createdBy == request.auth.uid
      );

      allow update: if isSignedIn() && (
        isSystemOwner() ||
        isSchoolAdmin(schoolId) ||
        isKnownSchool(schoolId)
      );

      allow delete: if isSystemOwner();

      // Students
      match /students/{studentId} {
        allow read: if canReadSchool(schoolId);
        allow create, update, delete: if isCounselor(schoolId);
      }

      // Morning Delays
      match /morningDelays/{delayId} {
        allow read: if canReadSchool(schoolId);
        allow create, update, delete: if isCounselor(schoolId);
      }

      // Absences (الغياب والحضور)
      match /absences/{absenceId} {
        allow read: if canReadSchool(schoolId);
        allow create, update, delete: if isCounselor(schoolId);
      }

      // Violations
      match /violations/{violationId} {
        allow read: if canReadSchool(schoolId);
        allow create, update, delete: if isCounselor(schoolId);
      }

      // Warning Forms (Model 9)
      match /warningForms/{formId} {
        allow read: if canReadSchool(schoolId);
        allow create, update, delete: if isCounselor(schoolId);
      }

      // Parent Summon Forms (Model 8)
      match /parentSummonForms/{formId} {
        allow read: if canReadSchool(schoolId);
        allow create, update, delete: if isCounselor(schoolId);
      }

      // Violation Reports & Behavior Forms (Model 6, 7, 10, 12)
      match /behaviorForms/{formId} {
        allow read: if canReadSchool(schoolId);
        allow create, update, delete: if isCounselor(schoolId);
      }

      // Unified Official Documents & E-Signatures
      match /officialDocuments/{docId} {
        allow read: if canReadSchool(schoolId);
        allow create, update, delete: if isCounselor(schoolId);
      }

      // Committee Meetings & Sessions
      match /committeeMeetings/{meetingId} {
        allow read: if canReadSchool(schoolId);
        allow create, update, delete: if isCounselor(schoolId);
      }
      match /meetings/{meetingId} {
        allow read: if canReadSchool(schoolId);
        allow create, update, delete: if isCounselor(schoolId);
      }

      // Staff & Employees
      match /staff_members/{staffId} {
        allow read: if canReadSchool(schoolId);
        allow create, update, delete: if isCounselor(schoolId);
      }

      // Committee Formation & Guidance Registries
      match /committee_formation/{formationId} {
        allow read: if canReadSchool(schoolId);
        allow write: if isCounselor(schoolId);
      }

      // Signatures
      match /signatures/{signatureId} {
        allow read: if canReadSchool(schoolId);
        allow create, update, delete: if isCounselor(schoolId);
      }

      // Imports
      match /imports/{importId} {
        allow read: if canReadSchool(schoolId);
        allow create, update, delete: if isCounselor(schoolId);
      }

      // Audit Logs: strict rules - no update, no delete!
      match /auditLogs/{logId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }

      // School Settings (including customLabels & messageSettings)
      match /settings/{settingId} {
        allow read: if true;
        allow write: if isSignedIn();
      }

      // Message Templates
      match /messageTemplates/{templateId} {
        allow read: if isAuthorizedCommunicator(schoolId);
        allow create, update: if isAuthorizedCommunicator(schoolId);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // Message Drafts
      match /messageDrafts/{draftId} {
        allow read: if isAuthorizedCommunicator(schoolId);
        allow create: if isAuthorizedCommunicator(schoolId);
        allow update, delete: if isSchoolAdmin(schoolId) || (isAuthorizedCommunicator(schoolId) && resource.data.createdBy == request.auth.uid);
      }

      // Message Logs (Staff cannot modify other staff members' send logs without admin privileges)
      match /messageLogs/{logId} {
        allow read: if isAuthorizedCommunicator(schoolId);
        allow create: if isAuthorizedCommunicator(schoolId);
        allow update: if isSchoolAdmin(schoolId) || (isAuthorizedCommunicator(schoolId) && resource.data.createdBy == request.auth.uid);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // Message Queues
      match /messageQueues/{queueId} {
        allow read: if isAuthorizedCommunicator(schoolId);
        allow create, update: if isAuthorizedCommunicator(schoolId);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // Gmail OAuth & Automated Notification Configuration (non-sensitive metadata & templates; write restricted to Admin only)
      match /gmailConfig/{docId} {
        allow read: if canReadSchool(schoolId);
        allow create, update: if isSchoolAdmin(schoolId);
        allow delete: if false;
      }

      // Server-side OAuth CSRF States (strictly Admin / Server Admin SDK only)
      match /gmailOAuthStates/{stateId} {
        allow read, create, update: if isSchoolAdmin(schoolId);
        allow delete: if isSystemAdmin();
      }

      // Gmail Automated Notification Queue & Audit Trail (no deletion to preserve official audit trail)
      match /gmailNotificationQueue/{queueId} {
        allow read: if canReadSchool(schoolId);
        allow create, update: if isCounselor(schoolId);
        allow delete: if false;
      }
    }

    // --------------------------------------------------------------------------
    // Registration Requests collection
    // --------------------------------------------------------------------------
    match /registrationRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == requestId;
      allow update: if isSignedIn() && (
        request.auth.uid == requestId ||
        isSystemOwner() ||
        (isUserActive() && (getUserRole() == 'school_admin' || getUserRole() == 'schoolAdmin'))
      );
      allow delete: if isSystemOwner();
    }

    // --------------------------------------------------------------------------
    // Settings root-level collection rules (e.g. settings/school_info)
    // --------------------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --------------------------------------------------------------------------
    // Student Cases and Forms (إدارة الحالات والإرشاد)
    // --------------------------------------------------------------------------
    match /studentCases/{caseId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSystemAdmin();

      match /forms/{formId} {
        allow read, create, update: if isSignedIn();
        allow delete: if isSystemAdmin();
      }

      match /counselingSessions/{sessionId} {
        allow read, create, update: if isSignedIn();
        allow delete: if isSystemAdmin();
      }
    }
  }
}
